# FareRide environment variables.
# Copy to .env for local development: cp .env.example .env
# Never commit real secrets. Production values come from the cloud secret manager.
# Every variable is validated at startup (packages/config); the app refuses to boot on invalid values.

# ── Runtime ─────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ── API (apps/api) ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# How long /ready waits for each dependency before reporting it down.
READINESS_TIMEOUT_MS=2000

# ── Data stores ────────────────────────────────────────────────────────
# MongoDB connection string. Local default matches docker-compose.yml (single-node replica set).
# For Atlas use the mongodb+srv:// string of a FareRide-only database user, in your local .env
# or the secret manager. Never commit it or paste it into code, docs or chat.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
# FareRide always uses this database, whatever database the URI names.
MONGODB_DB_NAME=fareride
REDIS_URL=redis://localhost:6379

# ── Regional defaults (launch market not decided yet, see ADR 0008) ────
# ISO 4217 currency code
DEFAULT_CURRENCY=USD
# ISO 3166-1 alpha-2 region used to parse local phone numbers
DEFAULT_PHONE_REGION=US
DEFAULT_LOCALE=en
# IANA time zone
DEFAULT_TIME_ZONE=UTC

# ── Web apps (public, exposed to the browser: never put secrets here) ──
NEXT_PUBLIC_API_URL=http://localhost:4000
