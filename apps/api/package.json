{
  "name": "@fareride/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently --kill-others --names tsc,api --prefix-colors blue,green \"pnpm:dev:compile\" \"pnpm:dev:serve\"",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --env-file-if-exists=../../.env --watch-path=dist --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fareride/config": "workspace:*",
    "@fareride/types": "workspace:*",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "mongoose": "^9.10.3",
    "nestjs-pino": "^5.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fareride/eslint-config": "workspace:*",
    "@fareride/tsconfig": "workspace:*",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
