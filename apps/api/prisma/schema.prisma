// FareRide database schema. The full contract is docs/DATABASE.md;
// tables are added phase by phase as their modules are built.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Runtime configuration that admins can change without a deploy (fare rules, feature flags).
model SystemConfig {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_config")
}
